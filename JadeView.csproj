<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>JadeView</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <EmbeddedResource Include="formats/live_texture_keys.json.gz" LogicalName="JadeView.LiveTextureKeys" />
    <EmbeddedResource Include="formats/native_texture_key_maps.json.gz" LogicalName="JadeView.NativeTextureKeyMaps" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/script-model-functions.json" LogicalName="JadeView.CinematicScriptModelFunctions" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/script-function-names.json" LogicalName="JadeView.CinematicScriptFunctionNames" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/script-function-calls.json" LogicalName="JadeView.CinematicScriptFunctionCalls" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/script-callback-dispatch.json" LogicalName="JadeView.CinematicScriptCallbackDispatch" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/script-world-scheduler-operations.json" LogicalName="JadeView.CinematicWorldSchedulerOperations" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/script-engine-calls.json.gz" LogicalName="JadeView.CinematicScriptEngineCalls" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/script-message-readers.json.gz" LogicalName="JadeView.CinematicScriptMessageReaders" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/script-ova-field-accesses.json.gz" LogicalName="JadeView.CinematicScriptOvaFieldAccesses" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/script-function-source-references.json.gz" LogicalName="JadeView.CinematicScriptSourceReferences" />
    <EmbeddedResource Include="src/Features/Cinematics/Data/engine-function-selectors.json" LogicalName="JadeView.EngineFunctionSelectors" />
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
  </ItemGroup>
</Project>
